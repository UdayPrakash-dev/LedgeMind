# Copy this file to .env and fill in values. .env is ignored by Git.
POSTGRES_USER=ledgemind
POSTGRES_PASSWORD=ledgemind
POSTGRES_DB=ledgemind

# Any OpenAI-compatible endpoint (Groq, OpenAI, Ollama at http://host.docker.internal:11434/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Seconds between AI calls (free tiers limit requests per minute)
LLM_MIN_INTERVAL_S=2.0
# Reasoning models (gpt-oss) think before answering: allow enough tokens, keep thinking short
LLM_MAX_TOKENS=1024
LLM_REASONING_EFFORT=low
# Recovery strategy for STUCK transfers: off | llm_no_verifier
STRATEGY=llm_no_verifier

# What new transfers do when the payment rail fails: refund | retry | escalate
RECOVERY_POLICY=refund
