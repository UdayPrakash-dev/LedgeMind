# Copy this file to .env and fill in values. .env is ignored by Git.
POSTGRES_USER=ledgemind
POSTGRES_PASSWORD=ledgemind
POSTGRES_DB=ledgemind

# Google Gemini through its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Seconds between AI calls (free tier limits requests per minute)
LLM_MIN_INTERVAL_S=4.5
LLM_MAX_TOKENS=1024
LLM_REASONING_EFFORT=low
# Recovery strategy for STUCK transfers: off | llm_no_verifier | llm_verified_memory
STRATEGY=llm_no_verifier

# What new transfers do when the payment rail fails: refund | retry | escalate
RECOVERY_POLICY=refund
